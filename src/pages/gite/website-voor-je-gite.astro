<Article
  title="Een website voor je gîte"
  description="Wat een website voor je gîte nodig heeft: foto's, tarieven, beschikbaarheid, talen en de wettelijke vermeldingen."
  lastChecked="22 november 2026"
  cta="gite"
  sources={[
    { label: 'Service-public.fr: aanmelding meublé de tourisme', url: 'https://www.service-public.gouv.fr/particuliers/vosdroits/R14321' },
