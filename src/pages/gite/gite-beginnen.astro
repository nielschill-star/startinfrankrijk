<Article
  title="Gîte beginnen: bedrijfsvorm en belasting"
  description="De fiscale en juridische basis van een gîte in Frankrijk: loueur en meublé, de micro-regeling en waar je de actuele regels vindt."
  lastChecked="22 november 2026"
  cta="gite"
  draft
  sources={[
    { label: 'Service-public.fr: inkomsten uit gemeubileerde verhuur', url: 'https://www.service-public.gouv.fr/particuliers/vosdroits/F32744' },
    { label: 'Service Public Entreprendre: toeristische verhuur en micro-entreprise', url: 'https://entreprendre.service-public.gouv.fr/vosdroits/F39451' },
    { label: 'Impots.gouv.fr: de gemeubileerde verhuur', url: 'https://www.impots.gouv.fr/particulier/les-locations-meublees' },
